{
  "schema_version": 1,
  "experiment": {
    "name": "paper3090_pythia_model_kv_pressure",
    "seed": 7
  },
  "paths": {
    "results_root": "${PROJECT_ROOT}/results/pythia_model_kv_pressure",
    "legacy_results_roots": [],
    "trace": "${PROJECT_ROOT}/data/sharegpt_trace.json"
  },
  "models": {
    "target": "${PROJECT_ROOT}/models/models--EleutherAI--pythia-2.8b",
    "draft": "${PROJECT_ROOT}/models/models--EleutherAI--pythia-160m",
    "target_label": "Pythia-2.8B",
    "draft_label": "Pythia-160M",
    "draft_backend": "local"
  },
  "cuda": {
    "pytorch_cuda_alloc_conf": "expandable_segments:True"
  },
  "execution": {
    "python": "python",
    "isolate_by": "experiment_n",
    "continue_on_error": false,
    "skip_existing": true
  },
  "common": {
    "fixed_ks": [1, 3],
    "kmax": 3,
    "block_tokens": 16,
    "max_batch": 4,
    "cache_replay_chunk_tokens": 16,
    "calib_requests": 3,
    "requests_per_N": 32,
    "adaptive_slo_tpot_mult": 1.5,
    "adaptive_slo_ttft_mult": 2.0,
    "adaptive_slo_scope": "bucket"
  },
  "experiments": [
    {
      "name": "pythia_model_kv256",
      "kind": "kv_sweep",
      "tag": "paper3090_model_pythia28b_kv256",
      "Ns": [32],
      "kv_blocks": 256,
      "max_new_tokens": 48,
      "output_lengths": [24, 48],
      "prompt_hard_max": 384,
      "beta": 1.5,
      "policies": [
        "SpecSched",
        "SpecSched-LRU",
        "SpecSched-Longest",
        "SpecSched-H2O"
      ]
    },
    {
      "name": "pythia_model_kv512",
      "kind": "kv_sweep",
      "tag": "paper3090_model_pythia28b_kv512",
      "Ns": [32],
      "kv_blocks": 512,
      "max_new_tokens": 48,
      "output_lengths": [24, 48],
      "prompt_hard_max": 384,
      "beta": 1.5,
      "policies": [
        "SpecSched",
        "SpecSched-LRU",
        "SpecSched-Longest",
        "SpecSched-H2O"
      ]
    }
  ]
}
