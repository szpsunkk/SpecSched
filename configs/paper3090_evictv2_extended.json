{
  "schema_version": 1,
  "experiment": {
    "name": "paper3090_evictv2_extended",
    "seed": 7
  },
  "paths": {
    "results_root": "${PROJECT_ROOT}/results/evictv2_extended",
    "legacy_results_roots": [],
    "trace": "${PROJECT_ROOT}/data/sharegpt_trace.json"
  },
  "models": {
    "target": "${PROJECT_ROOT}/models/models--Qwen--Qwen2.5-7B-Instruct",
    "draft": "${PROJECT_ROOT}/models/models--Qwen--Qwen2.5-0.5B-Instruct",
    "target_label": "Qwen2.5-7B-Instruct",
    "draft_label": "Qwen2.5-0.5B-Instruct",
    "draft_backend": "local"
  },
  "cuda": {
    "pytorch_cuda_alloc_conf": "expandable_segments:True"
  },
  "execution": {
    "python": "python",
    "isolate_by": "experiment_n",
    "continue_on_error": false,
    "skip_existing": true
  },
  "common": {
    "fixed_ks": [1, 3, 5, 7],
    "kmax": 7,
    "block_tokens": 16,
    "max_batch": 4,
    "cache_replay_chunk_tokens": 32,
    "calib_requests": 6,
    "requests_per_N": 32,
    "adaptive_slo_tpot_mult": 1.5,
    "adaptive_slo_ttft_mult": 2.0,
    "adaptive_slo_scope": "bucket"
  },
  "experiments": [
    {
      "name": "kv768_evictv2_extended",
      "kind": "kv_sweep",
      "tag": "paper3090_evictv2_kv768",
      "Ns": [32, 64],
      "kv_blocks": 768,
      "max_new_tokens": 256,
      "output_lengths": [128, 192, 256],
      "prompt_hard_max": 768,
      "beta": 1.5,
      "policies": [
        "SpecSched",
        "SpecSched-EvictV2",
        "SpecSched-LRU",
        "SpecSched-Longest",
        "SpecSched-vLLM"
      ]
    },
    {
      "name": "kv1024_evictv2_extended",
      "kind": "kv_sweep",
      "tag": "paper3090_evictv2_kv1024",
      "Ns": [32, 64],
      "kv_blocks": 1024,
      "max_new_tokens": 256,
      "output_lengths": [128, 192, 256],
      "prompt_hard_max": 768,
      "beta": 1.5,
      "policies": [
        "SpecSched",
        "SpecSched-EvictV2",
        "SpecSched-LRU",
        "SpecSched-Longest",
        "SpecSched-vLLM"
      ]
    }
  ]
}
