{
  "schema_version": 1,
  "experiment": {
    "name": "paper_smoke_transfer_gpu",
    "seed": 123
  },
  "paths": {
    "results_root": "${PROJECT_ROOT}/results/smoke_transfer_gpu",
    "legacy_results_roots": [],
    "trace": "${PROJECT_ROOT}/data/sharegpt_trace.json"
  },
  "models": {
    "target": "${PROJECT_ROOT}/models/models--Qwen--Qwen2.5-0.5B-Instruct",
    "draft": "${PROJECT_ROOT}/models/models--Qwen--Qwen2.5-0.5B-Instruct",
    "target_label": "Qwen2.5-0.5B-Instruct",
    "draft_label": "Qwen2.5-0.5B-Instruct",
    "draft_backend": "local"
  },
  "cuda": {
    "pytorch_cuda_alloc_conf": "expandable_segments:True"
  },
  "execution": {
    "python": "python",
    "isolate_by": "experiment_n",
    "continue_on_error": false,
    "skip_existing": false
  },
  "common": {
    "fixed_ks": [1],
    "kmax": 1,
    "block_tokens": 16,
    "max_batch": 1,
    "max_admit_per_step": 1,
    "cache_replay_chunk_tokens": 8,
    "calib_requests": 1,
    "requests_per_N": 6,
    "adaptive_slo_tpot_mult": 2.0,
    "adaptive_slo_ttft_mult": 2.0,
    "adaptive_slo_scope": "bucket",
    "arrival_model": "trace"
  },
  "experiments": [
    {
      "name": "transfer_shift_smoke",
      "kind": "transfer_gpu",
      "tag": "smoke_transfer_shift",
      "Ns": [2],
      "kv_blocks": 64,
      "max_new_tokens": 2,
      "output_lengths": [2],
      "prompt_hard_max": 64,
      "beta": 2.0,
      "arrival_trace": "${PROJECT_ROOT}/data/transfer_traces_smoke/workload_shift_seed123.jsonl",
      "policies": ["FixedK-1", "SpecSched"]
    },
    {
      "name": "transfer_bursty_smoke",
      "kind": "transfer_gpu",
      "tag": "smoke_transfer_bursty",
      "Ns": [2],
      "kv_blocks": 64,
      "max_new_tokens": 2,
      "output_lengths": [2],
      "prompt_hard_max": 64,
      "beta": 2.0,
      "arrival_trace": "${PROJECT_ROOT}/data/transfer_traces_smoke/bursty_arrival_seed123.jsonl",
      "policies": ["FixedK-1", "SpecSched"]
    },
    {
      "name": "transfer_tiered_smoke",
      "kind": "transfer_gpu",
      "tag": "smoke_transfer_tiered",
      "Ns": [2],
      "kv_blocks": 64,
      "max_new_tokens": 2,
      "output_lengths": [2],
      "prompt_hard_max": 64,
      "beta": 2.0,
      "arrival_trace": "${PROJECT_ROOT}/data/transfer_traces_smoke/tiered_slo_seed123.jsonl",
      "tier_names": ["tier1", "tier2", "tier3"],
      "tier_weights": [0.3, 0.5, 0.2],
      "tier_tpot_mults": [0.8, 1.0, 1.5],
      "tier_ttft_mults": [0.8, 1.0, 1.5],
      "policies": ["FixedK-1", "SpecSched", "SpecSched-NoSLO"]
    }
  ]
}
